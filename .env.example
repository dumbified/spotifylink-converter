# Copy this file to .env and fill in the values:   cp .env.example .env
# .env is git-ignored. Never commit real values, and never paste them into chat.

# --- WhatsApp (from the Meta developer dashboard) ---

# A password you invent yourself (16+ characters). You type the same value
# into the Meta dashboard when registering the webhook.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_VERIFY_TOKEN=

# App settings > Basic > App secret
WHATSAPP_APP_SECRET=

# WhatsApp > API Setup > Access token (temporary ones expire after about 24 hours)
WHATSAPP_ACCESS_TOKEN=

# WhatsApp > API Setup > Phone number ID (a long number, not the phone number)
WHATSAPP_PHONE_NUMBER_ID=

# --- Who may use the bot ---

# Your own WhatsApp number in international format, digits only, e.g. 6591234567
# Several numbers can be separated with commas.
ALLOWED_SENDERS=

# --- Optional ---

# Two-letter country of your Apple Music account, e.g. us, gb, sg, my
ITUNES_COUNTRY=us

# Meta Graph API version, as shown in the dashboard's example request
GRAPH_API_VERSION=v24.0
